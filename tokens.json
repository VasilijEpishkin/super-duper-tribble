{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "canvas": { "$type": "color", "$value": "#131313", "$description": "Primary charcoal canvas from Stitch." },
    "earth": { "$type": "color", "$value": "#2C1900", "$description": "Warm secondary surface from Stitch." },
    "crimson": { "$type": "color", "$value": "#9C0000", "$description": "Sparse action accent from Stitch." },
    "silver": { "$type": "color", "$value": "#D8D8D8" },
    "text": { "$type": "color", "$value": "#E2E2E2" },
    "white": { "$type": "color", "$value": "#FFFFFF" },
    "surface": { "$type": "color", "$value": "#1B1B1B" },
    "surfaceRaised": { "$type": "color", "$value": "#2A2A2A" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "Courier Prime" },
    "body": { "$type": "fontFamily", "$value": "Geist" }
  },
  "type": {
    "display": { "$type": "typography", "$value": { "fontFamily": "Courier Prime", "fontSize": "56px", "fontWeight": 700, "lineHeight": "64px", "letterSpacing": "-0.04em" } },
    "heading": { "$type": "typography", "$value": { "fontFamily": "Courier Prime", "fontSize": "36px", "fontWeight": 700, "lineHeight": "44px", "letterSpacing": "-0.02em" } },
    "body": { "$type": "typography", "$value": { "fontFamily": "Geist", "fontSize": "16px", "fontWeight": 400, "lineHeight": "26px", "letterSpacing": "0.01em" } },
    "bodySmall": { "$type": "typography", "$value": { "fontFamily": "Geist", "fontSize": "14px", "fontWeight": 400, "lineHeight": "22px", "letterSpacing": "0.02em" } }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "32px" },
    "xl": { "$type": "dimension", "$value": "64px" }
  },
  "shape": {
    "corner": { "$type": "dimension", "$value": "0px" },
    "rule": { "$type": "dimension", "$value": "1px" }
  }
}
